{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "johnny-javelins",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // The game is static; only /api/* runs through the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "johnny-javelins-leaderboard",
      "database_id": "3849a2c0-1040-4bd4-b353-37c1ec81abcc",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "javelins.rjpw.space", "custom_domain": true }
  ]
}
